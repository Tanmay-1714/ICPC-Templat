struct snode{
  int value;
};

snode initial_value = snode{0};

class Segment_tree{
  public:
  vector<snode> svec;

  Segment_tree(int Size){
    int sSize = 1;
    while(sSize/2 < Size) sSize *= 2;
    svec = vector<snode>(sSize, initial_value);
  }

  snode merge(snode a, snode b){
    snode result = snode();

    /* change here for different results */

    result.value = min(a.value, b.value);
    return result;
  }

  void kernel_insert(snode elem, int ind, int curr, int L, int R){
    if(L == R){
      svec[curr] = elem;
      return;
    }

    int mid = (L + R) / 2;
    if(ind <= mid) kernel_insert(elem, ind, curr*2, L, mid);
    else kernel_insert(elem, ind, curr*2 + 1, mid + 1, R);

    svec[curr] = merge(svec[curr*2], svec[curr*2 + 1]);
  }

  snode kernel_query(int A, int B, int curr, int L, int R){
    snode result = initial_value;
    if(A <= L && R <= B) return svec[curr];
    int mid = (L + R) / 2;
    if(A <= mid) result = merge(result, kernel_query(A, B, curr*2, L, mid));
    if(mid + 1 <= B)result = merge(result, kernel_query(A, B, curr*2 + 1, mid + 1, R));
    return result;
  }

  void insert(snode elem, int ind){
    kernel_insert(elem, ind + 1, 1, 1, svec.size() / 2);
  }

  snode query(int L, int R){
    return kernel_query(L + 1, R + 1, 1, 1, svec.size() / 2);
  }

  void print(){
    vector<vector<int>> to_dbg;
    int ind = 1;
    int power = 1;
    int cnt = 1;
    vector<int> temp;
    while (ind < (int)svec.size()){
      temp.push_back(svec[ind].value);
      if(ind == cnt){
        to_dbg.push_back(temp);
        temp.clear();
        power *= 2;
        cnt += power;
      }
      ind ++;
    }
    if(temp.size() != 0)to_dbg.push_back(temp);
    for(auto elem: to_dbg){dbg(elem);}
  }
};
/*
   usages:
   internally it is 1-based indexing but whole interaction is scaled 
   so you can assume that whole is 0-based
   for adding fields change node

   creation: 
     snode initial_value = snode{0};
     Segment_tree seg_tree(size); 
   
   Insert:
     seg_tree.insert(snode elem, ind); 
   
   query will return a snode and u need to send snode elem
*/
